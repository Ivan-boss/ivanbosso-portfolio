---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import CustomCursor from '../components/CustomCursor.tsx';
import NeuralBg3D from '../components/NeuralBg3D.tsx';
import ShaderBg from '../components/ShaderBg.tsx';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config/site';
import { getLocale, alternatePath } from '../i18n/config';
import { t } from '../i18n/ui';

const locale = getLocale(Astro.url);
const T = t(locale);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object | object[];
}
const {
  title = T.meta.defaultTitle,
  description = T.meta.defaultDesc,
  image,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogPath = image || SITE.ogImage;
const ogImage = ogPath ? new URL(ogPath, SITE.url).href : undefined;

// Liens alternés (hreflang) pour le SEO multilingue.
const frHref = new URL(alternatePath(Astro.url, 'fr'), SITE.url).href;
const enHref = new URL(alternatePath(Astro.url, 'en'), SITE.url).href;
const ogLocale = locale === 'en' ? 'en_US' : 'fr_FR';
const ogLocaleAlt = locale === 'en' ? 'fr_FR' : 'en_US';
const htmlLang = locale === 'en' ? 'en' : 'fr';

// Données structurées (GEO/AI-SEO) : Person + WebSite globaux + JSON-LD de page
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: T.meta.jobTitle,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Nantes', addressCountry: 'FR' },
  sameAs: [SITE.linkedin].filter(Boolean),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Polytech Nantes' },
  worksFor: { '@type': 'Organization', name: 'IOD Solutions' },
  knowsAbout: [
    'Intelligence artificielle', 'LLM', 'RAG', 'NLP', 'Machine learning',
    'Data engineering', 'MLOps', 'Python', 'FastAPI', 'Google Cloud', 'React',
  ],
};
const websiteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url };
const allLd = [personLd, websiteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={frHref} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Photo du hero = élément LCP : on la charge en priorité, avant les fonds WebGL. */}
    {SITE.photo && <link rel="preload" as="image" href={SITE.photo} fetchpriority="high" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ivan Bosso" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Données structurées (GEO / AI-SEO) -->
    {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Lora:ital,wght@1,400;1,500;1,600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Analytics />
    <ClientRouter />
    <script is:inline>
      // ── Détection auto de la langue (1re visite uniquement) ───────────
      // Redirige FR → /en SI le navigateur préfère l'anglais ET qu'aucun
      // choix explicite n'a été mémorisé. Jamais EN → FR (FR = défaut).
      (function () {
        try {
          var KEY = 'ib-lang';
          var p = location.pathname;
          var isEN = p === '/en' || p.indexOf('/en/') === 0;
          var stored = null;
          try { stored = localStorage.getItem(KEY); } catch (e) {}
          var redirected = false;
          try { redirected = sessionStorage.getItem('ib-redirected') === '1'; } catch (e) {}
          if (!stored && !redirected && !isEN) {
            var langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || ''];
            var prefersEN = langs.length && String(langs[0]).toLowerCase().indexOf('en') === 0;
            if (prefersEN) {
              try { sessionStorage.setItem('ib-redirected', '1'); } catch (e) {}
              location.replace('/en' + (p === '/' ? '/' : p) + location.search + location.hash);
            }
          }
        } catch (e) {}
      })();
      // ── Mémorise le choix explicite de langue (clic sur le drapeau) ───
      (function () {
        if (window.__ibLangBound) return;
        window.__ibLangBound = true;
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('[data-lang-link]') : null;
          if (a) { try { localStorage.setItem('ib-lang', a.getAttribute('data-lang-link')); } catch (_) {} }
        });
      })();
      // reload → toujours revenir en haut (pas de restauration de scroll)
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      // loader UNIQUEMENT sur la home (FR « / » ou EN « /en/ ») ; masqué ailleurs ou si reduced-motion
      (function () {
        var p = location.pathname;
        var isHome = p === '/' || p === '/en' || p === '/en/';
        if (!isHome || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('loader-seen');
        }
      })();
    </script>
  </head>
  <body class="text-fg min-h-screen antialiased">
    <!-- Fond shader : vagues / dégradé fluide (étape 2), derrière tout -->
    <ShaderBg client:load transition:persist="shaderbg" />
    <!-- Fond nuageux mouvant (global) + orbes qui dérivent sur les côtés -->
    <div class="site-bg" aria-hidden="true" transition:persist="site-bg">
      <span class="bg-orb bg-orb-1"></span>
      <span class="bg-orb bg-orb-2"></span>
      <span class="bg-orb bg-orb-3"></span>
    </div>
    <!-- Réseau de neurones 3D plein écran (Three.js), derrière tout le contenu -->
    <NeuralBg3D client:load transition:persist="bg3d" />
    <!-- Voile de lisibilité (bande centrale) -->
    <div class="read-scrim" aria-hidden="true" transition:persist="read-scrim"></div>

    <!-- Écran de chargement (1×/session, sortie rapide, reduced-motion safe) -->
    <div id="ib-loader" aria-hidden="true">
      <div>
        <p class="ib-hello">{T.loader.pre}<span class="ib-accent">{T.loader.accent}</span>{T.loader.post}</p>
        <p class="ib-sub">{T.loader.sub}</p>
        <div class="ib-bar"><span></span></div>
      </div>
    </div>
    <script is:inline>
      window.scrollTo(0, 0); // top à chaque chargement
      (function () {
        var html = document.documentElement;
        var el = document.getElementById('ib-loader');
        if (!el || html.classList.contains('loader-seen')) return; // pas la home → masqué
        html.style.overflow = 'hidden';
        var ready = 0;
        var exited = false;
        // Le loader reste affiché le temps que SES PROPRES animations finissent
        // (sous-titre 1,25 s, barre de progression 1,3 s — cf. global.css).
        var MIN = 1800;
        // Avance donnée au hero : il s'anime EN COULISSES pendant ce délai, si
        // bien que le rideau se lève sur une photo et un texte déjà en place.
        var LEAD = 350;
        var start = Date.now();
        function exit() {
          if (exited) return;
          exited = true;
          // On calcule l'instant du hero, puis on cale le rideau LEAD ms après :
          // l'avance est ainsi garantie même sur machine lente (bg-ready tardif).
          var heroAt = Math.max(0, MIN - (Date.now() - start) - LEAD);
          window.setTimeout(function () {
            window.dispatchEvent(new Event('loader-done')); // 1) le hero entre, caché
          }, heroAt);
          window.setTimeout(function () {
            el.classList.add('ib-done'); // 2) le rideau se lève sur la page prête
            html.style.overflow = '';
            window.setTimeout(function () { html.classList.add('loader-seen'); }, 700);
          }, heroAt + LEAD);
        }
        // attend que les 2 fonds (shader + réseau 3D) aient rendu leur 1re image
        window.addEventListener('bg-ready', function () {
          ready++;
          if (ready >= 2) exit();
        });
        window.setTimeout(exit, 7000); // garde-fou (WebGL indisponible)
      })();
    </script>

    <CustomCursor client:idle transition:persist="cursor" />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Moteur d'animation (GSAP : entrée hero, reveals, scramble, compteurs, scroll-linked) -->
    <script>
      import '../scripts/anim.ts';
    </script>
  </body>
</html>
