---
// Logo d'entreprise : via Clearbit (dérivé du domaine) ou override `logo`,
// avec fallback sur le monogramme si le logo n'existe pas.
// `link` : si true et `website` fourni, rend le logo cliquable vers le site (nouvel onglet).
interface Props {
  client: string;
  monogram: string;
  logo?: string;
  website?: string;
  size?: number;
  link?: boolean;
  class?: string;
}
const { client, monogram, logo, website, size = 44, link = false, class: cls = '' } = Astro.props;

let logoSrc = logo;
if (!logoSrc && website) {
  try {
    const host = new URL(website).hostname.replace(/^www\./, '');
    logoSrc = `https://logo.clearbit.com/${host}`;
  } catch {}
}
const box = `width:${size}px;height:${size}px`;
const mono = Math.round(size / 3.2);
---

{/* Le visuel : logo (avec fallback monogramme via onerror) ou monogramme direct */}
{
  (() => {
    const visual = logoSrc ? (
      <span class:list={['relative grid shrink-0 place-items-center', cls]} style={box}>
        <img
          src={logoSrc}
          alt={`Logo ${client}`}
          width={size}
          height={size}
          loading="lazy"
          class="h-full w-full rounded-lg bg-white object-contain p-1"
          onerror="this.style.display='none';this.nextElementSibling.style.display='grid';"
        />
        <span
          class="absolute inset-0 hidden place-items-center rounded-lg border border-line bg-base font-mono font-bold text-fg"
          style={`font-size:${mono}px`}
        >
          {monogram}
        </span>
      </span>
    ) : (
      <span
        title={client}
        class:list={['grid shrink-0 place-items-center rounded-lg border border-line bg-base font-mono font-bold text-fg', cls]}
        style={`${box};font-size:${mono}px`}
      >
        {monogram}
      </span>
    );

    return link && website ? (
      <a
        href={website}
        target="_blank"
        rel="noopener"
        title={`${client} · site officiel`}
        class="inline-block rounded-lg transition-transform duration-200 hover:scale-110 hover:ring-2 hover:ring-accent-bright/50"
      >
        {visual}
      </a>
    ) : (
      visual
    );
  })()
}
