---
// Affiche le vrai logo client s'il est fourni (project.logo), sinon le monogramme.
// Un seul endroit à modifier pour le rendu des logos.
interface Props {
  client: string;
  monogram: string;
  logo?: string;
  size?: number; // px
  class?: string;
}
const { client, monogram, logo, size = 44, class: cls = '' } = Astro.props;
---

{
  logo ? (
    <img
      src={logo}
      alt={`Logo ${client}`}
      width={size}
      height={size}
      loading="lazy"
      class:list={['rounded-lg bg-white object-contain p-1', cls]}
      style={`width:${size}px;height:${size}px`}
    />
  ) : (
    <span
      title={client}
      class:list={[
        'grid place-items-center rounded-lg border border-line bg-base font-mono font-bold text-fg',
        cls,
      ]}
      style={`width:${size}px;height:${size}px;font-size:${Math.round(size / 3.2)}px`}
    >
      {monogram}
    </span>
  )
}
