---
import type { Project } from '../data/projects';
import ClientLogo from './ClientLogo.astro';
import { getLocale, localizePath } from '../i18n/config';
import { t } from '../i18n/ui';
interface Props { project: Project; variant?: string }
const { project, variant = '' } = Astro.props;
const locale = getLocale(Astro.url);
const T = t(locale).caseStudy;
---

<a
  href={localizePath(`/portfolio/${project.slug}`, locale)}
  data-tilt
  class:list={['glass reveal group relative flex flex-col gap-5 rounded-xl p-6', variant]}
>
  <!-- En-tête : logo client + domaine -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <ClientLogo client={project.client} monogram={project.monogram} logo={project.logo} website={project.website} size={44} />
      <div>
        <p class="text-sm font-semibold text-fg">{project.client}</p>
        <p class="text-xs text-muted">{project.domain === 'IA' ? T.cardAppliedAI : T.cardData}</p>
      </div>
    </div>
    <span
      class:list={[
        'rounded-full px-2.5 py-1 font-mono text-[11px] font-semibold',
        project.domain === 'IA' ? 'bg-accent/20 text-accent-bright' : 'bg-citron/15 text-citron',
      ]}
    >
      {project.domain}
    </span>
  </div>

  <!-- Big line : la tâche -->
  <div>
    <h3 class="text-lg font-bold leading-snug text-fg group-hover:text-accent-bright">{project.title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{project.task}</p>
  </div>

  <!-- Métrique vedette + flèche -->
  <div class="mt-auto flex items-end justify-between border-t border-line/60 pt-4">
    <div>
      <p class="font-mono text-2xl font-bold text-fg" data-count>{project.headline.value}</p>
      <p class="text-xs text-muted">{project.headline.label}</p>
    </div>
    <span class="flex items-center gap-1 text-sm text-accent-bright opacity-0 transition-opacity group-hover:opacity-100">
      {T.cardCta}
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>
