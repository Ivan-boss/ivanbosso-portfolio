---
import { getLocale, localizePath } from '../i18n/config';
import { t } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';

const locale = getLocale(Astro.url);
const T = t(locale);
const home = localizePath('/', locale);

// NB : /services reste accessible par lien direct, mais n'est pas dans le menu principal.
const links = [
  { href: localizePath('/portfolio', locale), label: T.nav.portfolio },
  { href: localizePath('/cv', locale), label: T.nav.cv },
  { href: localizePath('/contact', locale), label: T.nav.contact },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-base/70 backdrop-blur-md">
  <nav class="wrap flex h-16 items-center justify-between">
    <a href={home} class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-md bg-accent text-white transition-colors group-hover:bg-accent-bright"
        >IB</span
      >
      <span class="text-fg">Ivan&nbsp;Bosso</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'text-sm transition-colors hover:text-fg',
              path === l.href || (l.href !== home && path.startsWith(l.href)) ? 'text-fg' : 'text-muted',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={localizePath('/contact', locale)}
        class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-bright"
        >{T.nav.cta}</a
      >
      <LangSwitcher />
    </div>

    <div class="flex items-center gap-3 md:hidden">
      <LangSwitcher />
      <a href={localizePath('/portfolio', locale)} class="text-sm text-muted hover:text-fg">{T.nav.menu}</a>
    </div>
  </nav>
</header>
