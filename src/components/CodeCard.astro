---
import { Code } from 'astro:components';

// Coloration syntaxique Shiki au BUILD = zéro JS client. Signature « ingénieur ».
const snippet = `class IvanBosso:
    role         = "Ingénieur Data / IA"
    localisation = "Nantes, France"
    je_fais      = ["concevoir", "déployer en production", "mesurer"]
    obsession    = "la valeur livrée, pas la techno"

    def collaborer(self) -> str:
        return "parlons de votre besoin →"
`;
---

<section class="wrap mt-24">
  <div class="reveal grid items-center gap-10 lg:grid-cols-2">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-muted">// whoami</p>
      <h2 class="mt-3 text-2xl font-bold sm:text-3xl">En quelques lignes</h2>
      <p class="mt-4 max-w-md leading-relaxed text-muted">
        Un profil qui part du besoin, conçoit la solution, la met en production et en mesure les
        résultats. La technologie est un moyen, jamais une fin.
      </p>
    </div>

    <div
      class="overflow-hidden rounded-xl border border-line/70 bg-surface/70 shadow-2xl shadow-black/50"
    >
      <div class="flex items-center gap-2 border-b border-line/60 px-4 py-3">
        <span class="h-3 w-3 rounded-full" style="background:#ff5f56"></span>
        <span class="h-3 w-3 rounded-full" style="background:#ffbd2e"></span>
        <span class="h-3 w-3 rounded-full" style="background:#27c93f"></span>
        <span class="ml-2 font-mono text-xs text-muted">ivan_bosso.py</span>
      </div>
      <div class="codecard overflow-x-auto p-4 text-sm leading-relaxed">
        <Code code={snippet} lang="python" theme="night-owl" />
      </div>
    </div>
  </div>
</section>
