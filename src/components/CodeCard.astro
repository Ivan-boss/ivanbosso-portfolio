---
import { Code } from 'astro:components';
import { getLocale } from '../i18n/config';
import { t } from '../i18n/ui';
import { CODE_SNIPPET } from '../i18n/content';

// Coloration syntaxique Shiki au BUILD = zéro JS client. Signature « ingénieur ».
const locale = getLocale(Astro.url);
const T = t(locale).home;
const snippet = CODE_SNIPPET[locale];
---

<section class="wrap mt-24">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div class="reveal r-left">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-muted">{T.whoamiEyebrow}</p>
      <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{T.whoamiTitle}</h2>
      <p class="mt-4 max-w-md leading-relaxed text-muted">{T.whoamiBody}</p>
    </div>

    <div
      class="glass reveal r-right overflow-hidden rounded-xl shadow-2xl shadow-black/50"
      data-tilt
    >
      <div class="flex items-center gap-2 border-b border-line/60 px-4 py-3">
        <span class="h-3 w-3 rounded-full" style="background:#ff5f56"></span>
        <span class="h-3 w-3 rounded-full" style="background:#ffbd2e"></span>
        <span class="h-3 w-3 rounded-full" style="background:#27c93f"></span>
        <span class="ml-2 font-mono text-xs text-muted">ivan_bosso.py</span>
      </div>
      <div class="codecard overflow-x-auto p-4 text-xs leading-relaxed sm:text-sm">
        <Code code={snippet} lang="python" theme="night-owl" />
      </div>
    </div>
  </div>
</section>
