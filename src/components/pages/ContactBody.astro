---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import { getLocale } from '../../i18n/config';
import { t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const T = t(locale).contact;

const title = 'Contact · Ivan Bosso';
const desc =
  locale === 'en'
    ? 'Contact Ivan Bosso, Data/AI Engineer in Nantes, France: email and LinkedIn. Open to new opportunities.'
    : "Contacter Ivan Bosso, ingénieur Data/IA à Nantes : email et LinkedIn. Ouvert aux nouvelles opportunités.";
---

<Base title={title} description={desc}>
  <section class="wrap pt-16 sm:pt-24">
    <p class="reveal font-mono text-sm text-accent-bright">{T.eyebrow}</p>
    <h1 class="reveal mt-3 text-3xl font-black tracking-tight sm:text-5xl">{T.h1}</h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted">{T.intro}</p>

    <div class="reveal mt-10 grid gap-4 sm:grid-cols-2">
      <a href={`mailto:${SITE.email}`} class="group rounded-xl glass p-6 transition-colors hover:border-accent-bright/60">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-accent-bright/10 text-accent-bright"><Icon name="mail" size={20} /></span>
          <p class="font-mono text-xs uppercase tracking-widest text-muted">{T.email}</p>
        </div>
        <p class="mt-3 text-lg font-semibold text-fg group-hover:text-accent-bright">{SITE.email}</p>
      </a>
      <a href={SITE.linkedin} target="_blank" rel="noopener" class="group rounded-xl glass p-6 transition-colors hover:border-accent-bright/60">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-citron/15 text-citron"><Icon name="linkedin" size={20} /></span>
          <p class="font-mono text-xs uppercase tracking-widest text-muted">{T.linkedin}</p>
        </div>
        <p class="mt-3 text-lg font-semibold text-fg group-hover:text-accent-bright">in/ivan-bosso <span class="text-xs text-muted">↗</span></p>
      </a>
      <div class="rounded-xl glass p-6">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-accent-bright/10 text-accent-bright"><Icon name="phone" size={20} /></span>
          <p class="font-mono text-xs uppercase tracking-widest text-muted">{T.phone}</p>
        </div>
        <p class="mt-3 select-none text-lg font-semibold text-fg blur-[6px]" aria-hidden="true">+33 6 00 00 00 00</p>
        <p class="mt-1 text-xs text-muted">{T.phoneNote}</p>
      </div>
      <div class="rounded-xl glass p-6">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-citron/15 text-citron"><Icon name="map-pin" size={20} /></span>
          <p class="font-mono text-xs uppercase tracking-widest text-muted">{T.location}</p>
        </div>
        <p class="mt-3 text-lg font-semibold text-fg">{SITE.location} · {T.locationSuffix}</p>
      </div>
    </div>
  </section>
</Base>
