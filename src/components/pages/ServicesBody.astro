---
import Base from '../../layouts/Base.astro';
import { getLocale, localizePath } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { SERVICES } from '../../i18n/content';

const locale = getLocale(Astro.url);
const T = t(locale).services;
const services = SERVICES[locale];

const title = 'Services · Ivan Bosso';
const desc =
  locale === 'en'
    ? 'Data & AI: automate your processes, embed AI into your tools, make your data speak. Concrete, measured.'
    : "Data & IA : automatiser vos process, intégrer l'IA dans vos outils, faire parler vos données. Du concret, mesuré.";
---

<Base title={title} description={desc}>
  <section class="wrap pt-16 sm:pt-20">
    <p class="reveal font-mono text-sm text-accent-bright">{T.eyebrow}</p>
    <h1 class="reveal mt-3 text-3xl font-black tracking-tight sm:text-5xl">{T.h1}</h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted">{T.intro}</p>
  </section>

  <section class="wrap mt-12">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        services.map((s) => (
          <div class="reveal glass rounded-xl p-6">
            <h2 class="text-lg font-bold text-fg">{s.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-12 text-center">
      <a href={localizePath('/contact', locale)} class="inline-block rounded-md bg-accent px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-bright">
        {T.cta}
      </a>
    </div>
  </section>
</Base>
