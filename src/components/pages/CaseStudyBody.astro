---
import Base from '../../layouts/Base.astro';
import ClientLogo from '../ClientLogo.astro';
import Icon from '../Icon.astro';
import { getProjects } from '../../data/projects';
import { getLocale, localizePath } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props { slug: string }
const { slug } = Astro.props;

const locale = getLocale(Astro.url);
const T = t(locale).caseStudy;
const PROJECTS = getProjects(locale);
const idx = PROJECTS.findIndex((p) => p.slug === slug);
const project = PROJECTS[idx];
const next = PROJECTS[(idx + 1) % PROJECTS.length];

const steps = [
  { key: T.steps.probleme, icon: 'target', body: project.probleme, kind: 'text' as const },
  { key: T.steps.contrainte, icon: 'scale', body: project.contrainte, kind: 'text' as const },
  { key: T.steps.approche, icon: 'compass', body: project.approche, kind: 'list' as const },
  { key: T.steps.resultat, icon: 'bar-chart', body: project.resultat, kind: 'list' as const, accent: true },
];

const projectLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${project.client} — ${project.title}`,
  abstract: project.task,
  about: project.tags,
  keywords: project.stack.join(', '),
  creator: { '@type': 'Person', name: 'Ivan Bosso' },
  inLanguage: locale,
};
---

<Base title={`${project.client} · ${project.title}`} description={project.task} jsonLd={projectLd}>
  <article class="wrap pt-12 sm:pt-16">
    <a href={localizePath('/portfolio', locale)} class="text-sm text-muted transition-colors hover:text-fg">{T.back}</a>

    <!-- En-tête -->
    <header class="mt-6 border-b border-line/60 pb-8">
      <div class="flex items-center gap-3">
        <ClientLogo client={project.client} monogram={project.monogram} logo={project.logo} website={project.website} link={true} size={48} />
        <div>
          {
            project.website ? (
              <a href={project.website} target="_blank" rel="noopener" class="font-semibold text-fg transition-colors hover:text-accent-bright">
                {project.client} <span class="text-xs text-muted">↗</span>
              </a>
            ) : (
              <p class="font-semibold text-fg">{project.client}</p>
            )
          }
          <p class="text-xs text-muted">{project.domain === 'IA' ? T.appliedAI : T.dataProject} · {T.client}</p>
        </div>
        <span
          class:list={[
            'ml-auto rounded-full px-3 py-1 font-mono text-xs font-semibold',
            project.domain === 'IA' ? 'bg-accent/20 text-accent-bright' : 'bg-citron/15 text-citron',
          ]}
        >
          {project.domain}
        </span>
      </div>

      <h1 class="mt-6 max-w-3xl text-3xl font-black leading-tight tracking-tight sm:text-4xl">{project.title}</h1>

      <div class="mt-4 flex flex-wrap gap-2">
        {project.tags.map((tag) => <span class="rounded-full bg-surface/60 px-3 py-1 font-mono text-xs text-muted">{tag}</span>)}
      </div>

      <!-- Métriques vedettes -->
      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          project.metrics.map((m) => (
            <div class="glass rounded-xl p-5" data-tilt>
              <p class="font-mono text-2xl font-bold text-fg" data-count>{m.value}</p>
              <p class="mt-1 text-xs text-muted">{m.label}</p>
            </div>
          ))
        }
      </div>
    </header>

    <!-- Le fil : problème → résultat -->
    <div class="relative mt-10 max-w-3xl">
      <div class="absolute bottom-2 left-[7px] top-2 w-px bg-gradient-to-b from-accent-bright via-accent to-citron" data-scroll-draw></div>
      <div class="flex flex-col gap-10">
        {
          steps.map((s) => (
            <section class="reveal relative pl-8">
              <span
                class:list={[
                  'absolute left-0 top-1.5 h-3.5 w-3.5 rounded-full border-2 border-base',
                  s.accent ? 'bg-citron' : 'bg-accent-bright',
                ]}
              />
              <h2 class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted">
                <Icon name={s.icon} size={14} class={s.accent ? 'text-citron' : 'text-accent-bright'} />
                {s.key}
              </h2>
              {s.kind === 'text' ? (
                <p class="mt-2 text-lg leading-relaxed text-fg/95">{s.body}</p>
              ) : (
                <ul class="mt-3 flex flex-col gap-2.5">
                  {(s.body as string[]).map((item) => (
                    <li class="flex gap-3 text-fg/95">
                      <span class:list={['mt-2 h-1.5 w-1.5 shrink-0 rounded-full', s.accent ? 'bg-citron' : 'bg-accent-bright']} />
                      <span class="leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </div>

    <!-- Stack -->
    <section class="mt-12 max-w-3xl border-t border-line/60 pt-8">
      <h2 class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted">
        <Icon name="layers" size={14} class="text-accent-bright" />
        {T.stack}
      </h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          project.stack.map((tag) => (
            <span class="rounded-md border border-line/70 bg-surface/40 px-3 py-1.5 font-mono text-sm text-fg">{tag}</span>
          ))
        }
      </div>
    </section>

    <!-- Projet suivant -->
    <a
      href={localizePath(`/portfolio/${next.slug}`, locale)}
      class="glass mt-16 flex items-center justify-between rounded-xl p-6"
      data-tilt
    >
      <div>
        <p class="text-xs text-muted">{T.next}</p>
        <p class="mt-1 text-lg font-bold text-fg">{next.client} · {next.title}</p>
      </div>
      <span class="text-accent-bright">→</span>
    </a>
  </article>
</Base>
