---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'Mise en production de LLM',
    body: "Extraction documentaire, RAG, classification sémantique : du POC à un service fiable, évalué et observé (Langfuse, Logfire).",
  },
  {
    title: 'Pipelines data & intégration',
    body: "Ingestion multi-sources, scraping, orchestration (n8n), data platforms event-driven sur GCP. De la donnée brute à la décision.",
  },
  {
    title: 'NLP & ML appliqué',
    body: "Clustering non supervisé, scoring, NLP métier, avec anonymisation RGPD et résultats mesurés (ARI, F1, précision).",
  },
];
---

<Base title="Services · Ivan Bosso" description="Missions freelance data & IA avec Ivan Bosso : mise en production de LLM, pipelines data et intégration, NLP et ML appliqué. De la valeur métier, mesurée.">
  <section class="wrap pt-16 sm:pt-20">
    <p class="reveal font-mono text-sm text-accent-bright">// Services</p>
    <h1 class="reveal mt-3 text-3xl font-black tracking-tight sm:text-5xl">Travaillons ensemble</h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted">
      En complément de mon poste, j'accompagne des missions data/IA en freelance, toujours avec la même exigence :
      de la valeur métier, mesurée.
    </p>
  </section>

  <section class="wrap mt-12">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        services.map((s) => (
          <div class="reveal rounded-xl border border-line/70 bg-surface/40 p-6">
            <h2 class="text-lg font-bold text-fg">{s.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-12 text-center">
      <a href="/contact" class="inline-block rounded-md bg-accent px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-bright">
        Parler de votre besoin
      </a>
    </div>
  </section>
</Base>
