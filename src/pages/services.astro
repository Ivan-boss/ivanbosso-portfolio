---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'Automatiser vos tâches documentaires',
    body: 'Vos documents lus, extraits, classés et résumés automatiquement. Fini la saisie manuelle : vos équipes gagnent des heures, sans perdre en fiabilité. (LLM, RAG, contrôle qualité.)',
  },
  {
    title: 'Intégrer l’IA dans vos outils',
    body: 'Brancher l’IA sur vos systèmes existants et automatiser vos workflows : un chatbot, un copilote interne, un agent qui enchaîne les étapes à votre place. (n8n, API, agents.)',
  },
  {
    title: 'Faire parler vos données',
    body: 'Rassembler vos sources, repérer des tendances, scorer, prédire. Des décisions appuyées sur des chiffres, dans le respect du RGPD. (Data pipelines, NLP, ML, GCP.)',
  },
];
---

<Base title="Services · Ivan Bosso" description="Missions freelance data & IA : automatiser vos process, intégrer l'IA dans vos outils, faire parler vos données. Du concret, mesuré.">
  <section class="wrap pt-16 sm:pt-20">
    <p class="reveal font-mono text-sm text-accent-bright">// Services</p>
    <h1 class="reveal mt-3 text-3xl font-black tracking-tight sm:text-5xl">Travaillons ensemble</h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted">
      En complément de mon poste, j'accompagne des entreprises en freelance pour automatiser leurs
      tâches et intégrer l'IA dans leur quotidien. Le but est simple : vous faire gagner du temps, pour de vrai.
    </p>
  </section>

  <section class="wrap mt-12">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        services.map((s) => (
          <div class="reveal glass rounded-xl p-6">
            <h2 class="text-lg font-bold text-fg">{s.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-12 text-center">
      <a href="/contact" class="inline-block rounded-md bg-accent px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-bright">
        Parler de votre besoin
      </a>
    </div>
  </section>
</Base>
