---
import Base from '../../layouts/Base.astro';
import ClientLogo from '../../components/ClientLogo.astro';
import { PROJECTS } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const idx = PROJECTS.findIndex((p) => p.slug === project.slug);
const next = PROJECTS[(idx + 1) % PROJECTS.length];

const steps = [
  { key: 'Problème', body: project.probleme, kind: 'text' as const },
  { key: 'Contrainte', body: project.contrainte, kind: 'text' as const },
  { key: 'Approche', body: project.approche, kind: 'list' as const },
  { key: 'Résultat', body: project.resultat, kind: 'list' as const, accent: true },
];

const projectLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${project.client} — ${project.title}`,
  abstract: project.task,
  about: project.tags,
  keywords: project.stack.join(', '),
  creator: { '@type': 'Person', name: 'Ivan Bosso' },
  inLanguage: 'fr',
};
---

<Base title={`${project.client} · ${project.title}`} description={project.task} jsonLd={projectLd}>
  <article class="wrap pt-12 sm:pt-16">
    <a href="/portfolio" class="text-sm text-muted transition-colors hover:text-fg">← Tous les projets</a>

    <!-- En-tête -->
    <header class="mt-6 border-b border-line/60 pb-8">
      <div class="flex items-center gap-3">
        <ClientLogo client={project.client} monogram={project.monogram} logo={project.logo} size={48} />
        <div>
          <p class="font-semibold text-fg">{project.client}</p>
          <p class="text-xs text-muted">mission menée chez IOD Solutions</p>
        </div>
        <span
          class:list={[
            'ml-auto rounded-full px-3 py-1 font-mono text-xs font-semibold',
            project.domain === 'IA' ? 'bg-accent/20 text-accent-bright' : 'bg-citron/15 text-citron',
          ]}
        >
          {project.domain}
        </span>
      </div>

      <h1 class="mt-6 max-w-3xl text-3xl font-black leading-tight tracking-tight sm:text-4xl">{project.title}</h1>

      <div class="mt-4 flex flex-wrap gap-2">
        {project.tags.map((t) => <span class="rounded-full bg-surface/60 px-3 py-1 font-mono text-xs text-muted">{t}</span>)}
      </div>

      <!-- Métriques vedettes -->
      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          project.metrics.map((m) => (
            <div class="rounded-xl border border-line/70 bg-surface/40 p-5">
              <p class="font-mono text-2xl font-bold text-fg" data-count>{m.value}</p>
              <p class="mt-1 text-xs text-muted">{m.label}</p>
            </div>
          ))
        }
      </div>
    </header>

    <!-- Le fil : problème → résultat -->
    <div class="relative mt-10 max-w-3xl">
      <div class="absolute bottom-2 left-[7px] top-2 w-px bg-gradient-to-b from-accent-bright via-accent to-citron" data-scroll-draw></div>
      <div class="flex flex-col gap-10">
        {
          steps.map((s) => (
            <section class="reveal relative pl-8">
              <span
                class:list={[
                  'absolute left-0 top-1.5 h-3.5 w-3.5 rounded-full border-2 border-base',
                  s.accent ? 'bg-citron' : 'bg-accent-bright',
                ]}
              />
              <h2 class="font-mono text-xs uppercase tracking-widest text-muted">{s.key}</h2>
              {s.kind === 'text' ? (
                <p class="mt-2 text-lg leading-relaxed text-fg/90">{s.body}</p>
              ) : (
                <ul class="mt-3 flex flex-col gap-2.5">
                  {(s.body as string[]).map((item) => (
                    <li class="flex gap-3 text-fg/90">
                      <span class:list={['mt-2 h-1.5 w-1.5 shrink-0 rounded-full', s.accent ? 'bg-citron' : 'bg-accent-bright']} />
                      <span class="leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </div>

    <!-- Stack -->
    <section class="mt-12 max-w-3xl border-t border-line/60 pt-8">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted">Stack</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          project.stack.map((t) => (
            <span class="rounded-md border border-line/70 bg-surface/40 px-3 py-1.5 font-mono text-sm text-fg">{t}</span>
          ))
        }
      </div>
    </section>

    <!-- Projet suivant -->
    <a
      href={`/portfolio/${next.slug}`}
      class="mt-16 flex items-center justify-between rounded-xl border border-line/70 bg-surface/40 p-6 transition-colors hover:border-accent-bright/60"
    >
      <div>
        <p class="text-xs text-muted">Projet suivant</p>
        <p class="mt-1 text-lg font-bold text-fg">{next.client} · {next.title}</p>
      </div>
      <span class="text-accent-bright">→</span>
    </a>
  </article>
</Base>
