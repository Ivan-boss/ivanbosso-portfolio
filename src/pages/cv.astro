---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCvPath } from '../utils/cv';

// Détecté automatiquement : n'importe quel PDF déposé dans public/cv/
const cvPath = getCvPath();

// Compétences = le spectre large (ce que j'ai touché ou que je pratique),
// distinct des « outils du quotidien » de la page d'accueil (cœur de métier).
const skills = [
  { group: 'IA / LLM', icon: 'cpu', c: 'accent-bright', items: ['LLM en prod (Gemini, GPT, Mistral/Pixtral, Claude)', 'LLM de vision', 'RAG (FAISS, BM25, pgvector)', 'embeddings (BGE-M3)', 'agents & function calling', 'évaluation (Langfuse)'] },
  { group: 'ML / Data Science', icon: 'line-chart', c: 'citron', items: ['scikit-learn', 'PyTorch', 'clustering (UMAP, HDBSCAN, k-means)', 'NLP (spaCy, GLiNER, Presidio)', 'pandas / NumPy'] },
  { group: 'Data Engineering', icon: 'database', c: 'accent-bright', items: ['ETL / multi-sources (INSEE, BPE…)', 'dbt / Dataform', 'n8n', 'scraping (Playwright, Selenium)', 'BigQuery', 'PostgreSQL / pgvector', 'orchestration (Pub/Sub)'] },
  { group: 'Backend & Frontend', icon: 'code', c: 'citron', items: ['Python', 'FastAPI', 'SQLAlchemy async', 'Pydantic v2', 'Node.js', 'React 19', 'Next.js / Astro', 'TypeScript', 'Tailwind'] },
  { group: 'Cloud / DevOps', icon: 'cloud', c: 'accent-bright', items: ['GCP (Cloud Run, BigQuery, Pub/Sub)', 'Docker', 'CI/CD (GitHub Actions)', 'Terraform', 'Linux', 'archi hexagonale'] },
];

const SOFT: Record<string, string> = {
  'accent-bright': 'bg-accent-bright/10 text-accent-bright',
  citron: 'bg-citron/15 text-citron',
};
---

<Base title="CV · Ivan Bosso" description="CV d'Ivan Bosso, ingénieur Data/IA à Nantes : compétences LLM/RAG/NLP, data engineering, MLOps, full-stack, et formation Polytech Nantes. Téléchargeable en PDF.">
  <section class="wrap pt-16 sm:pt-20">
    <p class="reveal font-mono text-sm text-accent-bright">// CV</p>
    <div class="reveal mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-black tracking-tight sm:text-5xl">Ivan Bosso</h1>
        <p class="mt-2 text-lg text-muted">Ingénieur Data / IA · Nantes · TOEIC 945 · Permis B</p>
      </div>
      {
        cvPath ? (
          <a
            href={cvPath}
            download
            class="cta-pulse inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3 text-center font-semibold text-white transition-colors hover:bg-accent-bright"
          >
            <Icon name="rocket" size={18} />
            Télécharger mon CV
          </a>
        ) : (
          <span
            class="inline-block cursor-not-allowed rounded-md border border-line px-6 py-3 text-center font-semibold text-muted"
            title="Déposez un PDF dans public/cv/ pour activer le bouton"
          >
            CV bientôt disponible
          </span>
        )
      }
    </div>
    {
      !cvPath && (
        <p class="reveal mt-4 max-w-2xl text-muted">
          Astuce : déposez n'importe quel PDF dans <code class="font-mono text-fg">site/public/cv/</code> (le nom n'a aucune importance) et le bouton s'active automatiquement.
        </p>
      )
    }
  </section>

  <section class="wrap mt-12">
    <h2 class="reveal text-xl font-bold">Compétences</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        skills.map((s) => (
          <div class="reveal glass rounded-xl p-5">
            <h3 class="flex items-center gap-2.5 font-mono text-sm font-semibold text-fg">
              <span class:list={['grid h-8 w-8 shrink-0 place-items-center rounded-lg', SOFT[s.c]]}>
                <Icon name={s.icon} size={18} />
              </span>
              {s.group}
            </h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {s.items.map((it) => (
                <span class="rounded-md bg-base px-2.5 py-1 text-sm text-fg/90">{it}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap mt-16">
    <h2 class="reveal text-xl font-bold">Formation</h2>
    <ul class="reveal mt-4 flex flex-col gap-4 text-fg/90">
      <li>
        <a
          href="https://polytech.univ-nantes.fr"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 rounded-lg transition-colors hover:text-accent-bright"
        >
          <img
            src="/logos/polytech.png"
            alt="Polytech Nantes"
            width="44"
            height="44"
            class="h-11 w-11 rounded-md bg-white/90 p-1 shadow-sm transition-transform group-hover:scale-105"
            onerror="this.remove()"
          />
          <span class="text-lg font-semibold sm:text-xl">
            <strong class="text-fg group-hover:text-accent-bright">Polytech Nantes</strong>, diplôme d'ingénieur en informatique
            <span class="text-muted">· 2023-2026</span>
            <span class="ml-0.5 text-sm text-accent-bright opacity-0 transition-opacity group-hover:opacity-100">↗</span>
          </span>
        </a>
      </li>
    </ul>
  </section>
</Base>
